{
  "features": [
    "daily_delta_pct",
    "workers_present",
    "workers_required",
    "shortfall_workers",
    "productivity_ratio",
    "consecutive_stagnant",
    "has_active_hold",
    "unexplained_zero_progress"
  ],
  "optimal_threshold": 0.89,
  "severity_bands": {
    "low": [
      0.0,
      0.45
    ],
    "medium": [
      0.45,
      0.65
    ],
    "high": [
      0.65,
      0.85
    ],
    "critical": [
      0.85,
      1.0
    ]
  },
  "rules": [
    {
      "name": "implausible_progress_spike",
      "condition": "daily_delta_pct >= 14.0",
      "score": 0.98
    },
    {
      "name": "phantom_workforce",
      "condition": "workers_present >= 4 and delta <= 0.05 and stagnant >= 1 without active hold",
      "score": 0.95
    },
    {
      "name": "unreported_workforce",
      "condition": "workers_present == 0 and delta >= 2.0",
      "score": 0.96
    },
    {
      "name": "stagnant_despite_presence",
      "condition": "workers >= 0.8*req and stagnant >= 4 and delta <= 0.05",
      "score": 0.88
    }
  ],
  "metrics": {
    "precision": 0.6462,
    "recall": 1.0,
    "f1_score": 0.785,
    "pr_auc": 0.5401,
    "fpr": 0.0027,
    "precision_at_10": 0.2,
    "precision_at_20": 0.2,
    "precision_at_50": 0.54,
    "confusion_matrix": {
      "tp": 42,
      "fp": 23,
      "fn": 0,
      "tn": 8463
    }
  }
}