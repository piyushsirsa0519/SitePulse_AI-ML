# ==============================================================================
# SitePulse — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# DO NOT commit real secrets, API keys, or production credentials to source control.

# ------------------------------------------------------------------------------
# 1. CORE BACKEND & HTTP SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Active environment: 'development' | 'production' | 'test'
NODE_ENV=development

# Express HTTP server port (Default: 3000)
PORT=3000

# CORS Allowed Origin for browser API requests
# In production, set to exact frontend domain (e.g., https://sitepulse.example.com)
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. RELATIONAL DATABASE (POSTGRESQL / SUPABASE)
# ------------------------------------------------------------------------------
# Connection string for PostgreSQL 15+ database
# In local development without Postgres, leave commented to use the in-memory store.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sitepulse

# Optional separate database connection for automated test suites
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sitepulse_test

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTHENTICATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Project URL and Anonymous Public Key for client-side and JWT verification
# Note: Use Anon Key only. NEVER place the Service Role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 4. MACHINE LEARNING INFERENCE SERVICE (FASTAPI MICROSERVICE)
# ------------------------------------------------------------------------------
# Base URL for the Python FastAPI ML inference service (Default: http://127.0.0.1:8000)
ML_SERVICE_URL=http://127.0.0.1:8000

# Maximum request timeout in milliseconds for ML inference before fallback activates
ML_PREDICTION_TIMEOUT_MS=1500

# ------------------------------------------------------------------------------
# 5. AI COPILOT & LLM DECISION SUPPORT PROVIDER
# ------------------------------------------------------------------------------
# Active LLM provider: 'openai' | 'gemini' | 'anthropic' | 'mock'
# Use 'mock' for local offline testing and CI validation without billable API costs.
LLM_PROVIDER=mock

# Foundation model API key (Required if LLM_PROVIDER is not 'mock')
# Can also be set as OPENAI_API_KEY, GEMINI_API_KEY, or ANTHROPIC_API_KEY
LLM_API_KEY=

# Foundation model name
# Examples: 'gpt-4o-mini' (OpenAI), 'gemini-1.5-flash' (Gemini), 'claude-3-5-sonnet' (Anthropic)
LLM_MODEL=gpt-4o-mini

# Optional custom base URL for self-hosted LLM endpoints (e.g. Ollama, Azure, vLLM)
# Example for local Ollama: http://localhost:11434/v1/chat/completions
LLM_ENDPOINT=

# Maximum request timeout in milliseconds for LLM generation (Default: 25000 ms)
LLM_TIMEOUT_MS=25000
